<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:layout_marginEnd="4dp"
    android:background="@android:color/transparent">
    <ImageView
        android:id="@+id/bg_item"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/base_item_widget_view_description"
        android:src="@drawable/item_card_bg"
        android:scaleType="fitXY" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="9dp">
                <ImageView
                    android:id="@+id/bg_icon_item"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_bg"
                    android:scaleType="fitXY" />
                <TextView
                    android:id="@+id/txt_icon_item"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="12sp" />
            </FrameLayout>
            <TextView
                android:id="@+id/txt_item_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                android:lineHeight="20sp"
                android:lineSpacingExtra="4sp"
                android:maxLines="1"
                android:textSize="16sp"
                tools:targetApi="28" />
        </LinearLayout>
        <TextView
            android:id="@+id/txt_item_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginStart="33dp"
            android:fontFamily="sans-serif-medium"
            android:lineHeight="18sp"
            android:lineSpacingExtra="4sp"
            android:textSize="14sp"
            tools:targetApi="28" />
        <TextView
            android:id="@+id/txt_item_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:textSize="10sp"
            tools:ignore="SmallSp" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/chip_item_badge"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/bg_chip_item_badge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/chip_bg"
            android:scaleType="fitXY" />
        <TextView
            android:id="@+id/txt_item_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="11dp"
            android:textSize="11sp" />
    </FrameLayout>
</FrameLayout>